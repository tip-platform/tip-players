FROM golang:1.26-alpine AS build

WORKDIR /app

COPY go.mod go.sum .

RUN go mod download

COPY cmd/ ./cmd/
COPY internal/ ./internal/
COPY api/ ./api/

RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -ldflags="-w -s" -o /main ./cmd/main.go

FROM alpine:3.22.4

WORKDIR /

RUN addgroup -S appgroup && adduser -S appuser -G appgroup

EXPOSE 50051 8080

COPY --from=build --chown=appuser:appgroup /main /main

COPY --from=build --chown=appuser:appgroup /app/internal/infra/driven/persistence/sql ./internal/infra/driven/persistence/sql

USER appuser

ENTRYPOINT ["/main"]
